# PERSIAN PANEL Configuration

# Server
NODE_ENV=production
PORT=2053
DOMAIN=yourdomain.com

# Panel
PANEL_PATH=/panel

# Database
DATABASE_URL=sqlite:///app/data/persian-panel.db

# Security
SESSION_SECRET=your-random-secret-key-here-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional: Cloudflare
CF_DOMAIN=

# Timezone
TZ=Asia/Tehran
